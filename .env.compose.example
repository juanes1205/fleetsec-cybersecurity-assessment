# FleetSec Platform - Docker Compose Environment
PORT=3000
NODE_ENV=production
SEED_ON_STARTUP=true

# Initial Seed Credentials
SEED_ADMIN_PASSWORD=FleetSecAdmin2026!SecureKey
SEED_ANALYST_PASSWORD=FleetSecAnalyst2026!SecureKey
SEED_USER_PASSWORD=FleetSecUser2026!SecureKey

# JWT Security
JWT_SECRET=super-secure-production-jwt-secret-fleetsec-2026-key!
JWT_EXPIRES_IN=1h

# Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
